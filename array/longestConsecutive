nums = [100,4,200,1,3,2]

HashSet<Integer> set = new HashSet<>();
for (int i=0 ; i<nums.length;i++){
     set.add(nums[i]);
}
    for (int n : set){
    int longest =0 ;
     int length =1 ;
  if(!set.contains(n-1)){
    while (set.contains(n+length)){
          length ++
    }
     longest = Math.max(longest,length);
  }
}
  return longest ; 
