// square up the array 
// sort the array 
// put other half on second and other half on the first 
public long maxAlternatingSum(int[] nums){
    for (int i =0 ; i<nums.length ;i++){
        nums[i] = nums[i]*nums[i];
    }
Arrays.sort(nums);
 long  first = 0 ;
 long  second =0;
int halfLen = nums.length/2;
for (int i=0 ; i<halfLen ; i++){
  second +=(long) nums[i];
}
for (int i=halfLen ; i<nums.length ; i++){
  first +=(long) nums[i];
}
return first-second;

 }
