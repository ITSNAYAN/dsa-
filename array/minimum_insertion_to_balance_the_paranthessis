int  i =0 ; 
int count =0 ;
int res =0 ; 
while (i<s.length()){
char ch = s.charAt(i);
  if (ch=='('){
    count ++ ;
    i++;
  }else {
    if (count>0){
      count -- ;
    }else {
      res++; 
    }
    if (i+1 <s.length()&& s.charAt(i+1)=='('){
         i +=2 ;
    }else {
         res++;
         i++ 
    }
  }
  return res + count*2 ;
}
